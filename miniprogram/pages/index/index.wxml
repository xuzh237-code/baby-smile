<view class="page">
  <scroll-view scroll-y class="page-scroll">
    <view class="page-inner">
      <view class="header-card">
        <view class="header-top">
          <view class="brand">
            <view class="brand-icon">宝</view>
            <text class="brand-title">宝宝日志</text>
          </view>
          <view class="header-actions">
            <view class="baby-name-pill" bindtap="openBirthModal">{{birthInfo.name}}</view>
            <view class="stats-entry-pill" bindtap="openAnalysis">统计</view>
            <view class="wechat-login-pill {{syncLoggedIn ? 'logged-in' : ''}} {{syncBusy ? 'busy' : ''}}" bindtap="loginWithWechat">{{syncBusy ? '同步中' : syncActionText}}</view>
          </view>
        </view>

        <view class="age-strip">
          <view class="age-item">
            <text class="age-label">出生天数</text>
            <text class="age-value">{{ageSummary.totalDays}} 天</text>
          </view>
          <view class="age-item">
            <text class="age-label">月龄</text>
            <text class="age-value">{{ageSummary.monthLabel}}</text>
          </view>
          <view class="age-item">
            <text class="age-label">周数</text>
            <text class="age-value age-week">{{ageSummary.weekLabel}}</text>
          </view>
        </view>

        <view class="date-nav">
          <view class="nav-btn" data-offset="-1" bindtap="shiftDate">‹</view>
          <view class="date-display">
            <text class="date-label">{{viewDateLabel}}</text>
            <text class="date-tag">{{viewDateTag}}</text>
          </view>
          <view wx:if="{{viewDateTag !== '今天'}}" class="today-btn" bindtap="jumpToToday">今天</view>
          <view class="nav-btn" data-offset="1" bindtap="shiftDate">›</view>
        </view>

        <view class="sync-strip">
          <text class="sync-status {{syncLoggedIn ? 'online' : ''}}">{{syncStatusText}}</text>
        </view>
      </view>

      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-label">当日奶量</text>
          <view class="stat-value"><text class="amber">{{stats.milk}}</text><text class="stat-unit">ml</text></view>
        </view>
        <view class="stat-card">
          <text class="stat-label">当日便便</text>
          <view class="stat-value"><text class="emerald">{{stats.poop}}</text><text class="stat-unit">次</text></view>
        </view>
        <view class="stat-card">
          <text class="stat-label">当日睡眠</text>
          <view class="stat-value"><text class="sky">{{stats.sleep}}</text><text class="stat-unit">h</text></view>
        </view>
      </view>

      <view class="section-card">
        <view class="section-title-row amber-text">
          <view class="section-icon amber-soft">奶</view>
          <text class="section-title">喝奶</text>
        </view>
        <view class="tab-group">
          <view class="tab-btn {{milkType === '瓶喂母乳' ? 'active-yellow' : ''}}" data-type="瓶喂母乳" bindtap="setMilkType">瓶喂母乳</view>
          <view class="tab-btn {{milkType === '配方奶' ? 'active-yellow' : ''}}" data-type="配方奶" bindtap="setMilkType">配方奶</view>
        </view>
        <view class="action-row">
          <view class="input-wrap volume-wrap">
            <input class="field-input left" type="number" placeholder="输入奶量" value="{{milkVolume}}" confirm-type="done" bindinput="onMilkVolumeInput" bindconfirm="saveMilk" />
            <text class="unit-text">ml</text>
          </view>
          <button class="save-btn yellow" bindtap="saveMilk">记录</button>
        </view>
        <view class="time-grid">
          <view class="field-block">
            <text class="field-label">开始</text>
            <input class="field-input" data-key="milkStartTime" value="{{milkStartTime}}" selection-start="0" selection-end="5" confirm-type="next" bindinput="onMilkStartInput" bindblur="onTimeBlur" />
          </view>
          <view class="field-block">
            <text class="field-label">结束</text>
            <input class="field-input" data-key="milkEndTime" value="{{milkEndTime}}" selection-start="0" selection-end="5" confirm-type="done" bindinput="onMilkEndInput" bindblur="onTimeBlur" bindconfirm="saveMilk" />
          </view>
        </view>
      </view>

      <view class="section-card">
        <view class="section-title-row emerald-text">
          <view class="section-icon emerald-soft">尿</view>
          <text class="section-title">排泄</text>
        </view>
        <view class="tab-group">
          <view class="tab-btn {{poopType === '尿尿' ? 'active-green' : ''}}" data-type="尿尿" bindtap="setPoopType">尿尿</view>
          <view class="tab-btn {{poopType === '便便' ? 'active-green' : ''}}" data-type="便便" bindtap="setPoopType">便便</view>
          <view class="tab-btn {{poopType === '尿尿+便便' ? 'active-green' : ''}}" data-type="尿尿+便便" bindtap="setPoopType">都要</view>
        </view>
        <view class="action-row poop-action-row">
          <view class="field-block flex-1">
            <text class="field-label">时间</text>
            <input class="field-input" data-key="poopTime" value="{{poopTime}}" selection-start="0" selection-end="5" confirm-type="done" bindinput="onPoopTimeInput" bindblur="onTimeBlur" bindconfirm="savePoop" />
          </view>
          <button class="save-btn green" bindtap="savePoop">记录</button>
        </view>
      </view>

      <view class="section-card">
        <view class="section-head">
          <view class="section-title-row sky-text">
            <view class="section-icon sky-soft">月</view>
            <text class="section-title">睡眠</text>
          </view>
          <label class="switch-row">
            <text class="switch-label">跨天</text>
            <switch checked="{{sleepCrossDay}}" color="#38bdf8" bindchange="onSleepCrossChange" />
          </label>
        </view>
        <view class="time-grid">
          <view class="field-block">
            <text class="field-label">入睡</text>
            <input class="field-input" data-key="sleepStartTime" value="{{sleepStartTime}}" selection-start="0" selection-end="5" confirm-type="next" bindinput="onSleepStartInput" bindblur="onTimeBlur" />
          </view>
          <view class="field-block">
            <text class="field-label">醒来</text>
            <input class="field-input" data-key="sleepEndTime" value="{{sleepEndTime}}" selection-start="0" selection-end="5" confirm-type="done" bindinput="onSleepEndInput" bindblur="onTimeBlur" bindconfirm="saveSleep" />
          </view>
        </view>
        <view wx:if="{{showSleepAwakePanel}}" class="awake-panel">
          <view class="awake-head">
            <text class="field-label sky-text">夜间清醒时段</text>
            <text class="awake-hint">会自动扣除睡眠时长</text>
          </view>
          <view class="time-grid">
            <view class="field-block">
              <text class="field-label">开始</text>
              <input class="field-input" data-key="sleepAwakeStartTime" value="{{sleepAwakeStartTime}}" placeholder="例 05:00" selection-start="0" selection-end="5" confirm-type="next" bindinput="onSleepAwakeStartInput" bindblur="onTimeBlur" />
            </view>
            <view class="field-block">
              <text class="field-label">结束</text>
              <input class="field-input" data-key="sleepAwakeEndTime" value="{{sleepAwakeEndTime}}" placeholder="例 06:00" selection-start="0" selection-end="5" confirm-type="done" bindinput="onSleepAwakeEndInput" bindblur="onTimeBlur" bindconfirm="saveSleep" />
            </view>
          </view>
        </view>
        <button class="save-btn blue full" bindtap="saveSleep">{{sleepSaveLabel}}</button>
      </view>

      <view class="section-card">
        <view class="section-head">
          <view class="section-title-row indigo-text">
            <view class="section-icon indigo-soft">D</view>
            <text class="section-title">补剂</text>
          </view>
          <text class="hint-pill">{{supplementHint}}</text>
        </view>
        <view class="tab-group">
          <view class="tab-btn {{supplementType === 'AD' ? 'active-yellow' : ''}}" data-type="AD" bindtap="setSupplementType">AD</view>
          <view class="tab-btn {{supplementType === 'D3' ? 'active-yellow' : ''}}" data-type="D3" bindtap="setSupplementType">D3</view>
        </view>
        <view class="action-row supplement-action-row">
          <view class="field-block flex-1">
            <text class="field-label">时间</text>
            <input class="field-input" data-key="supplementTime" value="{{supplementTime}}" selection-start="0" selection-end="5" confirm-type="done" bindinput="onSupplementTimeInput" bindblur="onTimeBlur" bindconfirm="saveSupplement" />
          </view>
          <button class="save-btn indigo" bindtap="saveSupplement">记录</button>
        </view>
      </view>

      <view class="history-list">
        <view wx:if="{{!groupedRecords.length}}" class="empty-state">此日期暂无记录</view>
        <view wx:for="{{groupedRecords}}" wx:key="cat" class="history-group">
          <view class="group-head" data-cat="{{item.cat}}" bindtap="toggleCategory">
            <view>
              <text class="group-title {{item.colorClass}}">{{item.label}}</text>
              <text class="group-summary">{{item.summary}}</text>
            </view>
            <text class="group-arrow">{{item.collapsed ? '展开' : '收起'}}</text>
          </view>
          <view wx:if="{{!item.collapsed}}" class="group-records">
            <view wx:for="{{item.items}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="openEditModal">
              <view class="record-left">
                <view class="record-icon {{item.badgeClass}}">{{item.cat === '喝奶' ? '🍼' : item.cat === '排泄' ? '💧' : item.cat === '睡眠' ? '🌙' : '💊'}}</view>
                <view class="record-copy">
                  <view class="record-headline">
                    <text class="record-title">{{item.cat}}</text>
                    <text class="record-tag {{item.recordTagClass}}">{{item.type}}</text>
                    <text wx:if="{{item.hasAwakeTag}}" class="record-tag tag-sky">含清醒</text>
                  </view>
                  <text class="record-meta">记录时间 · {{item.time}}</text>
                </view>
              </view>
              <text class="record-value">{{item.val}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="footer-meta">小程序适配版 · v{{version}} · {{releaseDate}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{analysisVisible}}" class="overlay" bindtap="closeAnalysis"></view>
  <view wx:if="{{analysisVisible}}" class="sheet sheet-analysis">
    <view class="sheet-head">
      <text class="sheet-title">{{analysisTitle}}</text>
      <button class="sheet-close" bindtap="closeAnalysis">✕</button>
    </view>
    <view class="data-tools-row">
      <button class="data-tool-btn export" bindtap="exportData">导出CSV</button>
      <button class="data-tool-btn import" bindtap="importData">导入CSV</button>
    </view>
    <view class="tab-group compact">
      <view class="tab-btn {{analysisRange === 'day' ? 'active-yellow' : ''}}" data-range="day" bindtap="setAnalysisRange">7天</view>
      <view class="tab-btn {{analysisRange === 'week' ? 'active-yellow' : ''}}" data-range="week" bindtap="setAnalysisRange">14天</view>
      <view class="tab-btn {{analysisRange === 'month' ? 'active-yellow' : ''}}" data-range="month" bindtap="setAnalysisRange">30天</view>
      <view class="tab-btn {{analysisRange === 'quarter' ? 'active-yellow' : ''}}" data-range="quarter" bindtap="setAnalysisRange">90天</view>
      <view class="tab-btn {{analysisRange === 'year' ? 'active-yellow' : ''}}" data-range="year" bindtap="setAnalysisRange">365天</view>
    </view>
    <view class="average-row">
      <view>
        <text class="summary-label">奶量均值</text>
        <text class="summary-value amber-text">{{analysisMilkAverage}}ml</text>
      </view>
      <view>
        <text class="summary-label">睡眠均值</text>
        <text class="summary-value sky-text">{{analysisSleepAverage}}h</text>
      </view>
    </view>
    <view wx:if="{{analysisSelected}}" class="selected-card">
      <text class="selected-date">{{analysisSelected.fullLabel}}</text>
      <view class="selected-stats">
        <text>奶量 {{analysisSelected.milk}}ml</text>
        <text>便便 {{analysisSelected.poop}}次</text>
        <text>睡眠 {{analysisSelected.sleep}}h</text>
      </view>
    </view>
    <scroll-view scroll-x class="chart-scroll">
      <view class="chart-wrap">
        <view wx:for="{{analysisBuckets}}" wx:key="dateKey" class="chart-bucket" data-index="{{item.index}}" bindtap="selectAnalysisBucket">
          <view class="chart-bars">
            <view class="chart-bar milk {{item.muted ? 'muted' : ''}}" style="height: {{item.milkHeight}}rpx;"></view>
            <view class="chart-bar sleep {{item.muted ? 'muted' : ''}}" style="height: {{item.sleepHeight}}rpx;"></view>
          </view>
          <text class="chart-label">{{item.label}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{birthVisible}}" class="overlay" bindtap="closeBirthModal"></view>
  <view wx:if="{{birthVisible}}" class="sheet">
    <view class="sheet-head birth-sheet-head">
      <text class="sheet-title">出生信息</text>
      <button class="sheet-close" bindtap="closeBirthModal">✕</button>
    </view>
    <view class="field-block">
      <text class="field-label">宝宝名称</text>
      <input class="field-input left baby-name-input" maxlength="12" placeholder="请输入宝宝名称" value="{{birthDraft.name}}" bindinput="onBirthNameInput" />
    </view>
    <view class="field-block">
      <text class="field-label">出生日期</text>
      <picker mode="date" value="{{birthDraft.date}}" bindchange="onBirthDateChange">
        <view class="picker-field">{{birthDraft.date}}</view>
      </picker>
    </view>
    <view class="field-block">
      <text class="field-label">出生时间</text>
      <picker mode="time" value="{{birthDraft.time}}" bindchange="onBirthTimeChange">
        <view class="picker-field">{{birthDraft.time}}</view>
      </picker>
    </view>
    <view class="modal-actions">
      <button class="plain-btn" bindtap="closeBirthModal">取消</button>
      <button class="primary-btn amber" bindtap="saveBirthInfo">保存</button>
    </view>
  </view>

  <view wx:if="{{editVisible}}" class="overlay" bindtap="closeEditModal"></view>
  <view wx:if="{{editVisible}}" class="sheet">
    <view class="sheet-head edit-sheet-head">
      <text class="sheet-title">修改记录</text>
      <view class="delete-btn" bindtap="deleteEditRecord">删除</view>
    </view>
    <block wx:if="{{editForm.cat === '喝奶'}}">
      <view class="field-block">
        <text class="field-label">奶量</text>
        <input class="field-input left" type="number" data-key="volume" value="{{editForm.volume}}" bindinput="onEditInput" />
      </view>
      <view class="time-grid">
        <view class="field-block">
          <text class="field-label">开始</text>
          <input class="field-input" data-key="start" value="{{editForm.start}}" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
        </view>
        <view class="field-block">
          <text class="field-label">结束</text>
          <input class="field-input" data-key="end" value="{{editForm.end}}" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
        </view>
      </view>
      <view class="tab-group">
        <view class="tab-btn {{editForm.type === '瓶喂母乳' ? 'active-yellow' : ''}}" data-type="瓶喂母乳" bindtap="setEditType">瓶喂母乳</view>
        <view class="tab-btn {{editForm.type === '配方奶' ? 'active-yellow' : ''}}" data-type="配方奶" bindtap="setEditType">配方奶</view>
      </view>
    </block>
    <block wx:elif="{{editForm.cat === '排泄'}}">
      <view class="field-block">
        <text class="field-label">时间</text>
        <input class="field-input" data-key="time" value="{{editForm.time}}" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
      </view>
      <view class="tab-group">
        <view class="tab-btn {{editForm.type === '尿尿' ? 'active-green' : ''}}" data-type="尿尿" bindtap="setEditType">尿尿</view>
        <view class="tab-btn {{editForm.type === '便便' ? 'active-green' : ''}}" data-type="便便" bindtap="setEditType">便便</view>
        <view class="tab-btn {{editForm.type === '尿尿+便便' ? 'active-green' : ''}}" data-type="尿尿+便便" bindtap="setEditType">都要</view>
      </view>
    </block>
    <block wx:elif="{{editForm.cat === '补剂'}}">
      <view class="field-block">
        <text class="field-label">时间</text>
        <input class="field-input" data-key="time" value="{{editForm.time}}" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
      </view>
      <view class="tab-group">
        <view class="tab-btn {{editForm.type === 'AD' ? 'active-yellow' : ''}}" data-type="AD" bindtap="setEditType">AD</view>
        <view class="tab-btn {{editForm.type === 'D3' ? 'active-yellow' : ''}}" data-type="D3" bindtap="setEditType">D3</view>
      </view>
    </block>
    <block wx:elif="{{editForm.cat === '睡眠'}}">
      <view class="time-grid">
        <view class="field-block">
          <text class="field-label">入睡</text>
          <input class="field-input" data-key="start" value="{{editForm.start}}" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
        </view>
        <view class="field-block">
          <text class="field-label">醒来</text>
          <input class="field-input" data-key="end" value="{{editForm.end}}" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
        </view>
      </view>
      <label class="switch-card">
        <text class="field-label">跨天睡眠</text>
        <switch checked="{{editForm.cross}}" color="#38bdf8" data-key="cross" bindchange="onEditSwitchChange" />
      </label>
      <view class="time-grid">
        <view class="field-block">
          <text class="field-label">清醒开始</text>
          <input class="field-input" data-key="awakeStart" value="{{editForm.awakeStart}}" placeholder="例 05:00" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
        </view>
        <view class="field-block">
          <text class="field-label">清醒结束</text>
          <input class="field-input" data-key="awakeEnd" value="{{editForm.awakeEnd}}" placeholder="例 06:00" selection-start="0" selection-end="5" bindinput="onEditInput" bindblur="onEditTimeBlur" />
        </view>
      </view>
    </block>
    <view class="modal-actions">
      <button class="plain-btn" bindtap="closeEditModal">取消</button>
      <button class="primary-btn" bindtap="saveEditRecord">确认修改</button>
    </view>
  </view>

  <view wx:if="{{voiceVisible}}" class="overlay"></view>
  <view wx:if="{{voiceVisible}}" class="sheet">
    <view class="sheet-head">
      <text class="sheet-title">语音输入</text>
      <button class="sheet-close" bindtap="closeVoiceModal">✕</button>
    </view>
    <view class="example-card">
      <text class="example-title">可以这样说</text>
      <block wx:for="{{voiceExamples}}" wx:key="*this">
        <text class="example-line">{{item}}</text>
      </block>
    </view>
    <view class="voice-status">
      <text class="voice-status-title">{{voiceStatus}}</text>
      <text class="voice-status-hint">{{voiceHint}}</text>
    </view>
    <view class="voice-bars">
      <view wx:for="{{voiceBarHeights}}" wx:key="index" class="voice-bar {{voiceProcessing ? 'processing' : ''}}" style="height: {{item}}rpx;"></view>
    </view>
    <view class="transcript-card">
      <text class="field-label">识别内容</text>
      <text class="transcript-text">{{voiceTranscript}}</text>
    </view>
    <view class="modal-actions">
      <button class="plain-btn" bindtap="closeVoiceModal">取消</button>
      <button class="primary-btn rose" bindtap="retryVoice">重试</button>
    </view>
  </view>

  <view wx:if="{{voiceConfirmVisible}}" class="overlay"></view>
  <view wx:if="{{voiceConfirmVisible}}" class="dialog">
    <view class="dialog-head">
      <view>
        <text class="dialog-eyebrow">识别结果</text>
        <text class="dialog-title">这样记录对吗？</text>
      </view>
      <button class="sheet-close" bindtap="closeVoiceConfirm">✕</button>
    </view>
    <text class="dialog-summary">{{voiceConfirmSummary}}</text>
    <block wx:if="{{voiceConfirmMode === 'milk'}}">
      <view class="field-block">
        <text class="field-label">时间</text>
        <input class="field-input" data-key="time" value="{{voiceConfirmForm.time}}" bindinput="onVoiceConfirmInput" bindblur="onVoiceConfirmTimeBlur" />
      </view>
      <view class="tab-group">
        <view class="tab-btn {{voiceConfirmForm.type === '瓶喂母乳' ? 'active-yellow' : ''}}" data-type="瓶喂母乳" bindtap="setVoiceConfirmType">瓶喂母乳</view>
        <view class="tab-btn {{voiceConfirmForm.type === '配方奶' ? 'active-yellow' : ''}}" data-type="配方奶" bindtap="setVoiceConfirmType">配方奶</view>
      </view>
      <view class="field-block">
        <text class="field-label">奶量</text>
        <input class="field-input left" type="number" data-key="volume" value="{{voiceConfirmForm.volume}}" bindinput="onVoiceConfirmInput" />
      </view>
    </block>
    <block wx:elif="{{voiceConfirmMode === 'poop'}}">
      <view class="field-block">
        <text class="field-label">时间</text>
        <input class="field-input" data-key="time" value="{{voiceConfirmForm.time}}" bindinput="onVoiceConfirmInput" bindblur="onVoiceConfirmTimeBlur" />
      </view>
      <view class="tab-group">
        <view class="tab-btn {{voiceConfirmForm.type === '尿尿' ? 'active-green' : ''}}" data-type="尿尿" bindtap="setVoiceConfirmType">尿尿</view>
        <view class="tab-btn {{voiceConfirmForm.type === '便便' ? 'active-green' : ''}}" data-type="便便" bindtap="setVoiceConfirmType">便便</view>
        <view class="tab-btn {{voiceConfirmForm.type === '尿尿+便便' ? 'active-green' : ''}}" data-type="尿尿+便便" bindtap="setVoiceConfirmType">都要</view>
      </view>
    </block>
    <block wx:elif="{{voiceConfirmMode === 'supplement'}}">
      <view class="field-block">
        <text class="field-label">时间</text>
        <input class="field-input" data-key="time" value="{{voiceConfirmForm.time}}" bindinput="onVoiceConfirmInput" bindblur="onVoiceConfirmTimeBlur" />
      </view>
      <view class="tab-group">
        <view class="tab-btn {{voiceConfirmForm.type === 'AD' ? 'active-yellow' : ''}}" data-type="AD" bindtap="setVoiceConfirmType">AD</view>
        <view class="tab-btn {{voiceConfirmForm.type === 'D3' ? 'active-yellow' : ''}}" data-type="D3" bindtap="setVoiceConfirmType">D3</view>
      </view>
    </block>
    <block wx:elif="{{voiceConfirmMode === 'sleep'}}">
      <view class="time-grid">
        <view class="field-block">
          <text class="field-label">入睡</text>
          <input class="field-input" data-key="start" value="{{voiceConfirmForm.start}}" bindinput="onVoiceConfirmInput" bindblur="onVoiceConfirmTimeBlur" />
        </view>
        <view class="field-block">
          <text class="field-label">醒来</text>
          <input class="field-input" data-key="end" value="{{voiceConfirmForm.end}}" bindinput="onVoiceConfirmInput" bindblur="onVoiceConfirmTimeBlur" />
        </view>
      </view>
      <label class="switch-card">
        <text class="field-label">按跨天睡眠记录</text>
        <switch checked="{{voiceConfirmForm.cross}}" color="#38bdf8" data-key="cross" bindchange="onVoiceConfirmSwitchChange" />
      </label>
    </block>
    <view class="modal-actions">
      <button class="plain-btn" bindtap="closeVoiceConfirm">取消</button>
      <button class="plain-btn dark" bindtap="retryVoiceFromConfirm">重说</button>
      <button class="primary-btn rose" bindtap="confirmVoiceRecord">确认</button>
    </view>
  </view>
</view>
