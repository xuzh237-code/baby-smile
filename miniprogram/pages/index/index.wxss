.page {
  min-height: 100vh;
  background: #f8fafc;
}

.page-scroll {
  height: 100vh;
}

.page-inner {
  max-width: 760rpx;
  margin: 0 auto;
  padding: 20rpx 24rpx 240rpx;
}

.header-card,
.section-card,
.stat-card,
.history-group,
.sheet,
.dialog {
  background: #fff;
  box-shadow: 0 8rpx 40rpx rgba(15, 23, 42, 0.05);
}

.header-card,
.section-card,
.history-group {
  border-radius: 28rpx;
}

.header-card {
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.header-card::after {
  content: "";
  position: absolute;
  right: -80rpx;
  top: -96rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 999rpx;
  background: rgba(251, 191, 36, 0.1);
}

.header-top,
.section-head,
.group-head,
.sheet-head,
.dialog-head,
.action-row,
.awake-head,
.modal-actions,
.selected-stats,
.record-headline,
.record-card,
.record-left,
.header-actions,
.age-strip,
.date-nav,
.stats-grid,
.time-grid,
.tab-group,
.voice-bars,
.average-row,
.chart-wrap,
.chart-bars {
  display: flex;
}

.header-top,
.section-head,
.group-head,
.sheet-head,
.dialog-head,
.action-row,
.awake-head,
.modal-actions,
.record-card,
.record-left,
.date-nav {
  justify-content: space-between;
  align-items: center;
}

.brand,
.record-copy,
.date-display,
.field-block,
.selected-card,
.voice-status,
.transcript-card,
.example-card,
.age-item {
  display: flex;
  flex-direction: column;
}

.header-top,
.age-strip,
.date-nav {
  position: relative;
  z-index: 1;
}

.brand {
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.header-actions {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.brand-icon,
.icon-btn,
.nav-btn,
.today-btn,
.sheet-close,
.voice-fab {
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #f59e0b;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1e293b;
  white-space: nowrap;
}

.icon-btn,
.nav-btn,
.sheet-close {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 28rpx;
  padding: 0;
}

.sheet-close.danger {
  background: #fee2e2;
  color: #ef4444;
}

.age-strip {
  margin: 20rpx 0 16rpx;
  padding: 16rpx 18rpx;
  background: #fffbeb;
  border: 2rpx solid #fde68a;
  border-radius: 22rpx;
  gap: 14rpx;
}

.age-item {
  flex: 1;
  gap: 6rpx;
  min-width: 0;
}

.age-label,
.field-label,
.summary-label,
.example-title,
.dialog-eyebrow {
  font-size: 20rpx;
  font-weight: 800;
  color: #94a3b8;
}

.age-value,
.summary-value {
  font-size: 26rpx;
  font-weight: 900;
  color: #1e293b;
}

.age-week {
  font-size: 24rpx;
}

.date-nav {
  gap: 12rpx;
  padding: 8rpx;
  background: #f1f5f9;
  border-radius: 28rpx;
}

.date-display {
  flex: 1;
  align-items: center;
}

.date-label {
  font-size: 26rpx;
  font-weight: 900;
  color: #334155;
}

.date-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #f59e0b;
  margin-top: 4rpx;
}

.today-btn {
  min-width: 88rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #fff;
  color: #d97706;
  font-size: 22rpx;
  font-weight: 900;
  padding: 0 20rpx;
}

.stats-grid {
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.stat-card {
  flex: 1;
  padding: 22rpx 14rpx;
  border-radius: 24rpx;
  align-items: center;
}

.stat-label,
.record-meta,
.group-summary,
.hint-pill,
.awake-hint,
.dialog-summary {
  font-size: 20rpx;
  font-weight: 800;
  color: #94a3b8;
}

.stat-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-top: 8rpx;
}

.stat-value text:first-child {
  font-size: 40rpx;
  font-weight: 900;
}

.stat-unit {
  font-size: 20rpx;
  color: #cbd5e1;
}

.amber,
.amber-text { color: #d97706; }
.emerald,
.emerald-text { color: #059669; }
.sky,
.sky-text { color: #0284c7; }
.indigo-text { color: #4f46e5; }

.section-card,
.history-group {
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 900;
}

.section-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
}

.amber-soft { background: #fffbeb; color: #d97706; }
.emerald-soft { background: #ecfdf5; color: #059669; }
.sky-soft { background: #eff6ff; color: #0284c7; }
.indigo-soft { background: #eef2ff; color: #4f46e5; }

.section-head .section-title-row {
  min-width: 0;
}

.tab-group {
  margin-top: 20rpx;
  background: #f1f5f9;
  border-radius: 24rpx;
  padding: 8rpx;
  gap: 8rpx;
}

.tab-group.compact {
  margin-top: 0;
}

.tab-btn {
  flex: 1;
  min-height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}

.active-yellow {
  background: #fff;
  color: #b45309;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.active-green {
  background: #fff;
  color: #065f46;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.06);
}

.field-block {
  gap: 10rpx;
  flex: 1;
}

.action-row,
.time-grid {
  gap: 16rpx;
  margin-top: 20rpx;
}

.flex-1 {
  flex: 1;
}

.field-input,
.picker-field {
  width: 100%;
  min-height: 88rpx;
  background: #f8fafc;
  border: 2rpx solid #f1f5f9;
  border-radius: 22rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #1e293b;
  text-align: center;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.field-input.left {
  text-align: left;
}

.volume-wrap {
  position: relative;
  flex: 1;
}

.unit-text {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: #cbd5e1;
  font-weight: 800;
}

.save-btn,
.plain-btn,
.primary-btn {
  min-height: 88rpx;
  border-radius: 22rpx;
  font-size: 30rpx;
  font-weight: 900;
  padding: 0 32rpx;
}

.save-btn {
  color: #fff;
}

.save-btn.yellow,
.primary-btn.amber {
  background: #fbbf24;
  box-shadow: 0 14rpx 28rpx rgba(251, 191, 36, 0.18);
}

.save-btn.green {
  background: #10b981;
  box-shadow: 0 14rpx 28rpx rgba(16, 185, 129, 0.16);
}

.save-btn.blue,
.primary-btn {
  background: #0ea5e9;
  color: #fff;
  box-shadow: 0 14rpx 28rpx rgba(14, 165, 233, 0.16);
}

.save-btn.indigo {
  background: #6366f1;
  box-shadow: 0 14rpx 28rpx rgba(99, 102, 241, 0.16);
}

.save-btn.full {
  width: 100%;
  margin-top: 20rpx;
}

.switch-row,
.switch-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.switch-card {
  justify-content: space-between;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  margin-top: 16rpx;
}

.switch-label {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 800;
}

.awake-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #eff6ff;
}

.hint-pill {
  max-width: 420rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #4f46e5;
}

.group-title {
  font-size: 28rpx;
  font-weight: 900;
}

.group-summary,
.group-arrow {
  margin-top: 6rpx;
}

.group-arrow {
  font-size: 22rpx;
  font-weight: 800;
  color: #94a3b8;
}

.group-records {
  margin-top: 20rpx;
}

.record-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.record-card:last-child {
  border-bottom: none;
}

.record-left {
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.record-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
}

.badge-amber { background: #fffbeb; }
.badge-emerald { background: #ecfdf5; }
.badge-sky { background: #eff6ff; }
.badge-indigo { background: #eef2ff; }

.record-copy {
  flex: 1;
  min-width: 0;
  gap: 8rpx;
}

.record-headline {
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-start;
}

.record-title,
.record-value {
  font-size: 28rpx;
  font-weight: 900;
  color: #1e293b;
}

.record-value {
  max-width: 300rpx;
  text-align: right;
}

.record-tag {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
}

.tag-amber { background: #fffbeb; color: #b45309; }
.tag-emerald { background: #ecfdf5; color: #047857; }
.tag-sky { background: #eff6ff; color: #0284c7; }
.tag-indigo { background: #eef2ff; color: #4f46e5; }

.empty-state,
.footer-meta {
  text-align: center;
  color: #cbd5e1;
  font-weight: 800;
}

.empty-state {
  padding: 120rpx 0;
}

.footer-meta {
  font-size: 20rpx;
  padding: 20rpx 0 0;
}

.voice-fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  pointer-events: none;
}

.voice-fab {
  width: 132rpx;
  height: 132rpx;
  border-radius: 66rpx;
  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 54%, #eef2ff 100%);
  box-shadow:
    0 18rpx 42rpx rgba(15, 23, 42, 0.16),
    0 0 0 10rpx rgba(14, 165, 233, 0.08),
    0 0 0 20rpx rgba(244, 114, 182, 0.06);
  border: 2rpx solid rgba(226, 232, 240, 0.9);
  padding: 0;
  pointer-events: auto;
}

.voice-fab-disabled {
  opacity: 0.68;
}

.voice-mic {
  width: 58rpx;
  height: 70rpx;
  position: relative;
}

.voice-mic-head {
  position: absolute;
  left: 15rpx;
  top: 0;
  width: 28rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #0f172a;
}

.voice-mic-stem {
  position: absolute;
  left: 26rpx;
  top: 42rpx;
  width: 8rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #0f172a;
}

.voice-mic-base {
  position: absolute;
  left: 12rpx;
  bottom: 0;
  width: 34rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #0f172a;
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.3);
}

.sheet,
.dialog {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  border-radius: 32rpx;
  padding: 28rpx;
  z-index: 20;
}

.sheet-analysis {
  max-height: 88vh;
}

.sheet-title,
.dialog-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #1e293b;
}

.average-row {
  justify-content: space-between;
  margin: 24rpx 0;
}

.selected-card {
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f8fafc;
}

.selected-date {
  font-size: 26rpx;
  font-weight: 900;
}

.selected-stats {
  gap: 18rpx;
  flex-wrap: wrap;
  font-size: 22rpx;
  color: #64748b;
}

.chart-scroll {
  white-space: nowrap;
}

.chart-wrap {
  align-items: flex-end;
  gap: 18rpx;
  min-height: 340rpx;
  padding: 24rpx 0 8rpx;
}

.chart-bucket {
  width: 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.chart-bars {
  height: 280rpx;
  width: 100%;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
}

.chart-bar {
  width: 18rpx;
  border-radius: 999rpx;
}

.chart-bar.milk {
  background: #fbbf24;
}

.chart-bar.sleep {
  background: #38bdf8;
}

.chart-bar.muted {
  background: #cbd5e1;
}

.chart-label {
  font-size: 18rpx;
  color: #94a3b8;
  font-weight: 800;
}

.modal-actions {
  gap: 16rpx;
  margin-top: 24rpx;
}

.plain-btn,
.primary-btn {
  flex: 1;
  padding: 0;
}

.plain-btn {
  background: #f1f5f9;
  color: #64748b;
}

.plain-btn.dark {
  background: #0f172a;
  color: #fff;
}

.primary-btn.rose {
  background: #f43f5e;
}

.example-card,
.transcript-card {
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 24rpx;
  gap: 12rpx;
}

.example-line,
.voice-status-hint,
.transcript-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
  font-weight: 800;
}

.voice-status {
  gap: 10rpx;
  align-items: center;
  margin: 24rpx 0;
}

.voice-status-title {
  font-size: 30rpx;
  font-weight: 900;
}

.voice-bars {
  justify-content: center;
  align-items: flex-end;
  gap: 12rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.voice-bar {
  width: 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #fb7185 0%, #f97316 100%);
}

.voice-bar.processing {
  background: linear-gradient(180deg, #38bdf8 0%, #6366f1 100%);
}

.dialog {
  left: 32rpx;
  right: 32rpx;
  bottom: auto;
  top: 50%;
  transform: translateY(-50%);
}

.dialog-head {
  margin-bottom: 20rpx;
}

.dialog-title {
  display: block;
  margin-top: 8rpx;
}

.dialog-summary {
  display: block;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
